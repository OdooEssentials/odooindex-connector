<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_tree_inherit_odooindex" model="ir.ui.view">
        <field name="name">ir.module.module.list.inherit.odooindex</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="odooindex_target_version" />
                <field name="odooindex_latest_version" />
                <field name="odooindex_has_update" />
                <field name="odooindex_pr_count" />
                <field
                    name="odooindex_migration_status"
                    decoration-success="odooindex_migration_status == 'ready'"
                    decoration-warning="odooindex_migration_status == 'in_progress'"
                    decoration-danger="odooindex_migration_status == 'not_ready'"
                />
                <field name="odooindex_last_sync" />
            </field>
        </field>
    </record>

    <record id="view_module_filter_inherit_odooindex" model="ir.ui.view">
        <field name="name">ir.module.module.search.inherit.odooindex</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.view_module_filter" />
        <field name="arch" type="xml">
            <filter name="apps" position="before">
                <separator />
                <filter
                    name="odooindex_has_update"
                    string="Has Update"
                    domain="[('odooindex_has_update', '=', True)]"
                />
                <filter
                    name="odooindex_not_synced"
                    string="Not in OdooIndex"
                    domain="[('odooindex_last_sync', '=', False)]"
                />
                <filter
                    name="odooindex_ready"
                    string="Migration Ready"
                    domain="[('odooindex_migration_status', '=', 'ready')]"
                />
                <filter
                    name="odooindex_with_prs"
                    string="Has Open PRs"
                    domain="[('odooindex_pr_count', '>', 0)]"
                />
                <separator />
            </filter>
        </field>
    </record>
</odoo>
