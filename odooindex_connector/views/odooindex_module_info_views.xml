<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_odooindex_module_info" model="ir.actions.act_window">
        <field name="name">Module Updates</field>
        <field name="res_model">odooindex.module.info</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("module_id.state", "=", "installed")]</field>
    </record>

    <record id="odooindex_module_info_tree" model="ir.ui.view">
        <field name="name">odooindex.module.info.tree</field>
        <field name="model">odooindex.module.info</field>
        <field name="arch" type="xml">
            <list>
                <field name="module_id" />
                <field name="installed_version" />
                <field name="latest_version" />
                <field name="target_version" />
                <field
                    name="migration_status"
                    decoration-success="migration_status == 'ready'"
                    decoration-warning="migration_status == 'in_progress'"
                    decoration-danger="migration_status == 'not_ready'"
                />
                <field name="pr_count" />
                <field name="last_sync" />
            </list>
        </field>
    </record>

    <record id="odooindex_module_info_form" model="ir.ui.view">
        <field name="name">odooindex.module.info.form</field>
        <field name="model">odooindex.module.info</field>
        <field name="arch" type="xml">
            <form string="Module Update">
                <sheet>
                    <group>
                        <field name="module_id" />
                        <field name="name" />
                        <field name="installed_version" />
                        <field name="latest_version" />
                        <field name="target_version" />
                        <field name="migration_status" />
                        <field name="pr_count" />
                        <field name="last_sync" />
                    </group>
                    <group string="Pull Requests">
                        <field name="pr_ids" nolabel="1">
                            <list>
                                <field name="name" />
                                <field name="url" />
                                <field name="state" />
                                <field name="version" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem
        id="menu_odooindex_root"
        name="OdooIndex"
        parent="base.menu_main"
        sequence="200"
    />
    <menuitem
        id="menu_odooindex_module_info"
        name="Module Updates"
        parent="menu_odooindex_root"
        action="action_odooindex_module_info"
        sequence="10"
    />
</odoo>
