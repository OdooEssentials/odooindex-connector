<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_odooindex_module_report_tree" model="ir.ui.view">
        <field name="name">odooindex.module.report.tree</field>
        <field name="model">ir.module.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="author" />
                <field name="latest_version" string="Installed Version" />
                <field name="odooindex_target_version" />
                <field name="odooindex_latest_version" />
                <field name="odooindex_has_update" />
                <field name="odooindex_pr_count" />
                <field
                    name="odooindex_migration_status"
                    decoration-success="odooindex_migration_status == 'ready'"
                    decoration-warning="odooindex_migration_status == 'in_progress'"
                    decoration-danger="odooindex_migration_status == 'not_ready'"
                />
                <field name="odooindex_last_sync" />
            </list>
        </field>
    </record>

    <record id="view_odooindex_module_report_filter" model="ir.ui.view">
        <field name="name">odooindex.module.report.search</field>
        <field name="model">ir.module.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="author" />
                <separator />
                <filter
                    name="odooindex_has_update"
                    string="Has Update"
                    domain="[('odooindex_has_update', '=', True)]"
                />
                <filter
                    name="odooindex_not_synced"
                    string="Not in OdooIndex"
                    domain="[('odooindex_last_sync', '=', False)]"
                />
                <filter
                    name="odooindex_ready"
                    string="Migration Ready"
                    domain="[('odooindex_migration_status', '=', 'ready')]"
                />
                <filter
                    name="odooindex_with_prs"
                    string="Has Open PRs"
                    domain="[('odooindex_pr_count', '>', 0)]"
                />
                <separator />
                <filter
                    name="installed"
                    string="Installed"
                    domain="[('state', '=', 'installed')]"
                />
            </search>
        </field>
    </record>

    <record id="action_odooindex_module_report" model="ir.actions.act_window">
        <field name="name">OdooIndex Module Updates</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_odooindex_module_report_tree" />
        <field name="search_view_id" ref="view_odooindex_module_report_filter" />
        <field name="domain">[("state", "=", "installed")]</field>
    </record>

    <menuitem
        id="menu_odooindex_report"
        name="OdooIndex Module Updates"
        parent="base.menu_apps"
        action="action_odooindex_module_report"
        sequence="25"
        groups="base.group_system"
    />
</odoo>
