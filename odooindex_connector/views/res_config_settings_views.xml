<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_inherit_odooindex" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.odooindex</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[contains(@class, 'settings')]//div[@id='main_settings']" position="inside">
        <div class="app_settings_block" data-string="OdooIndex" string="OdooIndex" data-key="odooindex_connector">
          <h2>OdooIndex Connector</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_right_pane">
                <button name="action_open_odooindex_pair_wizard" type="object" string="Connect to OdooIndex" class="btn-primary"/>
                <button name="action_sync_modules" type="object" string="Sync Now" class="btn-secondary"/>
                <div class="content-group">
                  <span class="o_form_label">API Token</span>
                  <field name="odooindex_api_token" password="True"/>
                </div>
                <div class="content-group">
                  <span class="o_form_label">Target Version</span>
                  <field name="odooindex_target_version"/>
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
